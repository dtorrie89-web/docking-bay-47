            window.addEventListener("load", function () {
                window.cookieconsent.initialise({
                    "palette": {
                        "popup": {
                            "background": "#65afe0",
                            "text": "#ffffff"
                        },
                        "button": {
                            "background": "#f5c400",
                            "text": "#000000",
                        }
                    },
